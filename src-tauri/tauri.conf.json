{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Printust",
  "version": "0.1.0",
  "identifier": "com.printust.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Printust",
        "width": 380,
        "height": 540,
        "minWidth": 340,
        "minHeight": 480,
        "alwaysOnTop": true,
        "focus": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
